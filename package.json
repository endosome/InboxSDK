{
  "dependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/node": "^7.22.19",
    "@babel/plugin-transform-runtime": "^7.22.15",
    "@babel/preset-env": "^7.22.20",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.23.0",
    "@babel/register": "^7.22.15",
    "@calendarsdk/examples": "workspace:*",
    "@types/asap": "^2.0.0",
    "@types/gulp": "^4.0.6",
    "@types/jest": "^29",
    "@types/kefir": "^3.8.7",
    "@types/lodash": "^4.14.161",
    "@types/node": "^24.2.0",
    "@types/sinon": "^10.0.2",
    "@types/sinon-test": "^2.4.0",
    "@types/vinyl-source-stream": "^0.0.30",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "asap": "^2.0.3",
    "auto-html": "^1.0.4",
    "babel-jest": "^29",
    "babel-plugin-transform-inline-environment-variables": "^0.4.3",
    "buffer": "^6.0.3",
    "concat-stream": "^2.0.0",
    "eslint": "^8.41.0",
    "eslint-plugin-deprecate": "^0.7.0",
    "eslint-plugin-react": "^7.32.2",
    "fast-glob": "^3.2.5",
    "gulp": "^4.0.2",
    "gulp-dest-atomic": "^1.0.5",
    "husky": "^7.0.4",
    "jest": "^29.5.0",
    "kefir": "^3.8.3",
    "kefir-stopper": "^2.1.0",
    "lint-staged": "^12.3.5",
    "lodash": "^4.14.0",
    "pdelay": "^2.0.0",
    "postcss": "^8.4.21",
    "postcss-csso": "^6.0.1",
    "postcss-loader": "^7.2.4",
    "postcss-selector-parser": "^2.2.0",
    "prettier": "^3.0.3",
    "process": "^0.11.10",
    "sinon": "^11.1.1",
    "sinon-test": "^3.1.0",
    "stdio": "^0.2.6",
    "stylelint": "^15.6.2",
    "stylelint-config-css-modules": "^4.2.0",
    "stylelint-config-standard": "^33.0.0",
    "typescript": "^5.3.3"
  },
  "description": "Library for browser extensions to integrate with Google Calendar.",
  "license": "(MIT OR Apache-2.0)",
  "name": "calendarsdk",
  "private": true,
  "scripts": {
    "typecheck": "tsc",
    "typedefs": "tsc -p tsconfig.declarations.json",
    "prepare": "husky install",
    "lint": "yarn run lint:eslint && yarn run prettier:check",
    "lint:fix": "yarn run lint:eslint --fix && yarn run prettier:fix",
    "lint:eslint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:stylelint": "stylelint --allow-empty-input \"**/*.css\"",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "start": "gulp default -w --reloader",
    "test": "jest"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "version": "0.7.25",
  "workspaces": [
    "examples",
    "packages/*"
  ],
  "packageManager": "yarn@4.13.0",
  "devDependencies": {
    "babel-loader": "^9.1.2",
    "css-loader": "^6.7.3",
    "jest-css-modules": "^2.1.0",
    "jest-environment-jsdom": "^29.5.0",
    "source-map-loader": "^5.0.0",
    "style-loader": "^3.3.2",
    "webpack": "^5.76.3"
  }
}
