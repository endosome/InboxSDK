{
  "manifest_version": 3,
  "name": "CalendarSDK badges example",
  "version": "0.0.1",
  "description": "Adds a badge to every event on Google Calendar.",
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["icon.png"], "matches": ["https://calendar.google.com/*"] }
  ]
}
